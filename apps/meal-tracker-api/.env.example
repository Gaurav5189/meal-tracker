# Production environment variables for meal-tracker-api
# Never commit real secrets. Rotate all values before production use.

# Neon PostgreSQL (pooled connection string) — must be rotated manually
DATABASE_URL=

# Secret used to sign JWTs. Required when DEBUG=false; must be >= 32 chars
# Generate a new one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Comma-separated list of allowed CORS origins (set to deployed frontend origin)
CORS_ORIGINS=

# Cookie domain for production (leave empty for same-origin proxy / localhost)
COOKIE_DOMAIN=

# Set to true for production (secure cookies over HTTPS)
COOKIE_SECURE=true

# Debug flag (false in production)
DEBUG=false
